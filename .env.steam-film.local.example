# 复制为 .env.steam-film.local，并只在本机填写；实际配置会被 Git 忽略。
# SteamID64 是 17 位数字；Web API Key 只由 Node.js 本地同步程序读取。
STEAM_OWNER_ID=
STEAM_WEB_API_KEY=
STEAM_FILM_DATABASE_PATH=./var/steam-film-static.sqlite
# Optional: HTTP/HTTPS proxy used only by Steam API requests. See docs/steam-film-archive.md.
STEAM_FILM_HTTPS_PROXY=
